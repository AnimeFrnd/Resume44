{
  "name": "resume44",
  "version": "1.0.0",
  "private": true,
  "description": "Resume44 – AI Career Assistant. Android wrapper (Capacitor) around the static website.",
  "scripts": {
    "build:web": "node scripts/prepare-web.js",
    "android:add": "cap add android",
    "android:setup": "python3 scripts/android_setup.py android",
    "android:sync": "npm run build:web && cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
